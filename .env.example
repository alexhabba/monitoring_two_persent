# --- Bybit API (создайте ключ с правами ТОЛЬКО "Contract/Derivatives: Orders & Positions", без вывода средств) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
# Необязательно: другой хост API (например https://api.bytick.com)
BYBIT_BASE_URL=

# --- Режим ---
# true = только считает и пишет в лог, какие ордера поставил бы. Ордера НЕ отправляются.
DRY_RUN=true

# --- Аккаунт ---
ACCOUNT_TYPE=UNIFIED
CATEGORY=linear
SETTLE_COIN=USDT

# --- Условие закрытия ---
# Целевая прибыль за день от базы дня (с учётом комиссий, фандинга и издержек выхода), в %
TARGET_PROFIT_PCT=2.0
# База — баланс счёта (equity) на 00:00 по часовому поясу ниже (при первом запуске — на момент старта).
# Цель достигнута -> закрываются все позиции и все новые позиции до конца дня.
TIMEZONE=Europe/Moscow

# --- Файлы ---
DATA_DIR=data
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# --- Опрос ---
POLL_INTERVAL_SEC=10
CLOSE_LOOP_SLEEP_SEC=1

# --- Как закрываем ---
# Запас на проскальзывание при оценке выхода, б.п. (1 б.п. = 0.01%)
SLIPPAGE_BUFFER_BPS=2
# Считать глубину стакана в пределах N б.п. от лучшей цены
BOOK_DEPTH_BPS=10
# Максимум доли этой глубины в одном ордере (0.10 = 10%)
BOOK_FRACTION=0.10
# Не ставить ордера, если спред шире N б.п.
MAX_SPREAD_BPS=20
# Сколько ждать исполнения лимитки до отмены, сек
ORDER_TIMEOUT_SEC=15

# --- Копирование на другие счета (список счетов: data/followers.json, см. followers.example.json) ---
FOLLOWERS_FILE=
COPY_TICK_SEC=1
COPY_RATIO_REFRESH_SEC=60
COPY_DEADBAND_PCT=3

# --- Веб-интерфейс настроек (ключи основного и копирующих счетов). Пусто = выключен ---
# Заходите через SSH-туннель: ssh -L 8080:localhost:8080 root@<сервер>, затем http://localhost:8080
UI_PASSWORD=
UI_HOST=127.0.0.1
UI_PORT=8080

# --- Тест: база дня = состояние на момент старта (не восстанавливать сегодняшнюю прибыль по логу) ---
BASE_FROM_NOW=false

# --- WebSocket и лесенка тейк-профитов (основной счёт) ---
USE_WEBSOCKET=false
TP_LADDER=false
# Пачка тейк-профитов стоит там, где результат дня = коэффициент × цель дня (цель 2% и 2.0 → 2.6%)
TP_GOAL_COEF=2.0

# --- Закрытие по цели пачкой: вся позиция сразу несколькими лимитками у лучшей цены ---
CLOSE_PACK=false

TP_LADDER_FOLLOWERS=false
